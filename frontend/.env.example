# https://deacon-overcook-heftiness.ngrok-free.dev
# http://127.0.0.1:8000

# Leave blank for local development; Vite proxies API and WebSocket requests.
# Set this only when the backend is hosted at a different public origin.
VITE_API_BASE_URL=

# Optional CARTO Maps API key.
VITE_CARTO_MAP_API_KEY=

# Google photorealistic 3D command map (public browser key).
# Also accepts NEXT_PUBLIC_GOOGLE_MAPS_API_KEY or its lowercase spelling in
# frontend/.env or backend/.env. Only this exact key is exposed from backend.
# Restart Vite after changing backend/.env; enable Maps JavaScript API and
# billing in Google Cloud and allow your frontend URL in website restrictions.
VITE_GOOGLE_MAPS_API_KEY=

# Map region — LOCAL DEVELOPMENT ONLY; production is always panabo.
# Must match the backend's REGION. See backend/.env.example.
#   panabo (default) | new_corella (dev aid for testing away from Panabo)
VITE_REGION=panabo
