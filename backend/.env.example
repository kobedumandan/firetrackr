DATABASE_URL=postgresql://postgres:password@localhost:5432/bfp_capstone
JWT_SECRET=replace-with-a-random-secret

# Semaphore SMS
SEMAPHORE_API_KEY=your_semaphore_api_key_here
SEMAPHORE_SENDER_NAME=SEMAPHORE

# PhilSMS — reporter location-request links
PHILSMS_API_TOKEN=your_philsms_api_token_here
PHILSMS_SENDER_ID=PhilSMS
SEND_SMS=false
# Public base URL (ngrok/devtunnel to THIS backend) used to build reporter links
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.dev
# Dispatch alerts: push via Expo, SMS (needs SEND_SMS=true) for members with no
# registered phone. EXPO_ACCESS_TOKEN only if Expo "enhanced push security" is on.
DISPATCH_SMS_FALLBACK=true
EXPO_ACCESS_TOKEN=
# ── GIS / routing region (LOCAL DEVELOPMENT ONLY) ─────────────────────────────
# PRODUCTION IS ALWAYS panabo. FireTrackr was built for and proposed to BFP Panabo
# City; this switch exists only so a developer can test the app without being
# physically in Panabo. Do not change it on a deployed instance.
#   panabo      (default) the real system: digitised QGIS network + GAT constraints
#   new_corella local dev aid: OpenStreetMap network, no constraint weights
# Must match the frontend's VITE_REGION, or the map shows one municipality
# while the router plans over another. Takes effect on backend restart.
# New Corella data is built once with:
#   python fetch_osm_roads.py --region new_corella
REGION=panabo

# GNN inference (restart the backend after changing).
# exported: use precomputed GeoJSON constraints, then exported edge weights.
# If neither exists, warn and route on base travel times. No local ML needed.
# local: run the generic node GNN; skips exported constraint/edge-weight costs.
# This is NOT the notebook's SegmentGAT and does not retrain or call Lightning.
# Install optional dependencies: pip install -r requirements-ml.txt
GNN_INFERENCE_MODE=exported
# Local mode only:
GNN_TYPE=graphsage
TORCH_DEVICE=cpu
# Optional experimental RL needs torch, gymnasium and stable-baselines3 separately.
USE_RL=false
USE_SUMO=false
